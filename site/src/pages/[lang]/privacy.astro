---
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import { langPaths, type Lang } from '../../i18n/ui';
import { site } from '../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
// 草稿：開始使用數據分析或電子報之前，要先更新這一頁。
const copy = {
  'zh-tw': {
    title: '隱私權政策',
    description: '匠語 Craftongue 網站如何處理你的資料。',
    updated: '最後更新：2026-10-18（草稿）',
    sections: [
      { h: '簡單說', p: ['這個網站不需要登入，不使用追蹤用的 cookie，目前也不收集你的個人資料。'] },
      { h: '網站主機', p: ['本網站由 Cloudflare Pages 提供主機服務。為了安全和防止濫用，Cloudflare 可能會處理基本的連線資訊（例如 IP 位址）。詳情請看 <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare 隱私權政策</a>。'] },
      { h: 'AI 技能', p: ['技能在你自己使用的 AI 工具上執行。我們收不到你輸入給 AI 的任何內容。'] },
      { h: '之後可能的變更', p: ['我們之後可能加入不使用 cookie 的網站流量統計，以及 email 電子報訂閱。開始之前會先更新這一頁，說明收集哪些資料、用途和如何取消。'] },
      { h: '聯絡', p: ['對隱私有任何問題，請看<a href="../contact/">聯絡我們</a>。'] },
    ],
  },
  en: {
    title: 'Privacy Policy',
    description: 'How the Craftongue website handles your data.',
    updated: 'Last updated: 2026-10-18 (draft)',
    sections: [
      { h: 'In short', p: ['This site needs no login, uses no tracking cookies, and does not currently collect personal data.'] },
      { h: 'Hosting', p: ['This site is hosted on Cloudflare Pages. For security and abuse prevention, Cloudflare may process basic connection data such as IP addresses. See the <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare Privacy Policy</a>.'] },
      { h: 'Agent Skills', p: ['Skills run inside the AI tool you already use. We never receive anything you send to your AI.'] },
      { h: 'Future changes', p: ['We may later add cookie-free traffic statistics and an email newsletter. Before we do, this page will be updated to explain what is collected, why, and how to opt out.'] },
      { h: 'Contact', p: ['For privacy questions, see <a href="../contact/">Contact</a>.'] },
    ],
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description} draft={true}>
  <h1>{copy.title}</h1>
  {copy.updated && <p class="muted">{copy.updated}</p>}
  <Sections sections={copy.sections} />
</Base>
